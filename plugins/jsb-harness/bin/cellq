#!/usr/bin/env python3
"""cellq: the queue adapter, the only code that knows GitHub's labels,
sub-issue endpoints and comment formats (ADR 0007, ADR 0009).

Contract: specs/cellq.md. Standard library only, REST only via urllib.
Every success prints one JSON document on stdout and exits 0. An API or
validation failure prints one line on stderr and exits 1; a usage or
environment failure (no repo, no token, unknown verb) exits 2.
"""
import argparse
import getpass
import http.client
import json
import os
import re
import socket
import subprocess
import sys
import urllib.error
import urllib.request
from datetime import datetime, timezone

VERBS = [
    "idea", "scope", "claim", "complete", "state", "depend", "link",
    "request-feature", "ready", "list", "parent", "merged-count", "threshold",
]
STUBS = {"ready", "list", "parent"}
STATES = [
    "new", "needs-input", "ready", "blocked", "in-progress", "in-review",
    "done", "dropped",
]
# Label groups are single-valued per issue; set_group_label keeps them so.
# Each entry: (allowed values, label colour). A compiled pattern is allowed
# as a value for the open-ended `source:cell:<name>`.
GROUPS = {
    "state": (STATES, "1D76DB"),
    "route": (["small", "spec"], "5319E7"),
    "source": (["own", "ceremony", "agent", re.compile(r"cell:[^\s,]+")], "FBCA04"),
    "priority": (["1", "2", "3", "4", "5"], "B60205"),
}
DOD_TITLE = "Definition of done"
# Body-convention lines (specs/cellq.md): each stands alone, outside any
# section, so one also ends the section that precedes it.
CONVENTION_LINE = re.compile(r"(Depends on|Parent):.*")
DEPENDS_LINE = re.compile(r"Depends on:.*")


class Failure(Exception):
    """An API or validation failure: one line on stderr, exit 1."""


class HTTPFailure(Failure):
    def __init__(self, status, errors, message):
        super().__init__(message)
        self.status = status
        self.errors = errors  # GitHub's errors[].code values, e.g. "already_exists"


class UsageError(Exception):
    """A usage or environment failure: one line on stderr, exit 2."""


# ---------------------------------------------------------------- environment

def find_repo(explicit):
    if explicit:
        repo = explicit
    elif os.environ.get("GITHUB_REPOSITORY"):
        repo = os.environ["GITHUB_REPOSITORY"]
    else:
        try:
            url = subprocess.run(
                ["git", "remote", "get-url", "origin"],
                capture_output=True, text=True, check=True,
            ).stdout.strip()
        except (OSError, subprocess.CalledProcessError):
            raise UsageError("no repository: pass --repo o/r, set GITHUB_REPOSITORY, "
                             "or run inside a clone with an origin remote")
        m = re.search(r"github\.com[:/]([^/\s]+)/([^/\s]+?)(?:\.git)?/?$", url)
        if not m:
            raise UsageError(f"origin remote is not a GitHub repository: {url}")
        repo = f"{m.group(1)}/{m.group(2)}"
    if not re.fullmatch(r"[^/\s]+/[^/\s]+", repo):
        raise UsageError(f"repository must be owner/repo, got: {repo}")
    return repo


def find_token():
    for var in ("GH_TOKEN", "GITHUB_TOKEN"):
        if os.environ.get(var):
            return os.environ[var]
    try:
        out = subprocess.run(["gh", "auth", "token"], capture_output=True, text=True)
    except OSError:
        out = None
    if out is not None and out.returncode == 0 and out.stdout.strip():
        return out.stdout.strip()
    raise UsageError("no token: set GH_TOKEN or GITHUB_TOKEN, or log in with gh")


# ------------------------------------------------------------------- transport

class GitHub:
    def __init__(self, repo, token):
        self.repo = repo
        self.token = token
        self.base = os.environ.get("GITHUB_API_URL", "https://api.github.com").rstrip("/")

    def call(self, method, path, body=None):
        """One REST call under /repos/{o}/{r}; returns the parsed JSON body
        (None when empty). Raises Failure on any HTTP or network error."""
        return self.request(method, f"{self.base}/repos/{self.repo}{path}", body)

    def request(self, method, url, body=None):
        """One REST call to an absolute URL (for endpoints outside /repos)."""
        data = None if body is None else json.dumps(body).encode()
        headers = {
            "Accept": "application/vnd.github+json",
            "Authorization": f"Bearer {self.token}",
            "Content-Type": "application/json",
            "User-Agent": "cellq",
            "X-GitHub-Api-Version": "2022-11-28",
        }
        try:
            req = urllib.request.Request(url, data=data, method=method, headers=headers)
            with urllib.request.urlopen(req, timeout=30) as resp:
                raw = resp.read()
        except urllib.error.HTTPError as e:
            try:
                payload = json.loads(e.read())
            except ValueError:
                payload = {}
            errors = [x.get("code", "") for x in payload.get("errors", []) if isinstance(x, dict)]
            raise HTTPFailure(e.code, errors,
                              f"{method} {url}: HTTP {e.code} {payload.get('message', '')}".rstrip())
        except (OSError, ValueError, http.client.HTTPException) as e:
            raise Failure(f"{method} {url}: {getattr(e, 'reason', e)}")
        try:
            return json.loads(raw) if raw else None
        except ValueError:
            raise Failure(f"{method} {url}: response is not JSON")


# ---------------------------------------------------------------------- labels

def validate_label(group, value):
    allowed, _ = GROUPS[group]
    for a in allowed:
        if a == value or (not isinstance(a, str) and a.fullmatch(value)):
            return f"{group}:{value}"
    names = [a if isinstance(a, str) else "cell:<name>" for a in allowed]
    raise Failure(f"invalid {group}: {value!r} (one of {', '.join(names)})")


def ensure_label(gh, name):
    """Create the label on first use; 422 means it already exists."""
    group = name.split(":", 1)[0]
    try:
        gh.call("POST", "/labels", {"name": name, "color": GROUPS[group][1]})
    except HTTPFailure as e:
        if e.status != 422 or "already_exists" not in e.errors:
            raise


def set_group_label(gh, number, group, value):
    """Set `group:value` on the issue, removing every other label of that
    group. Returns the issue as fetched before the change."""
    name = validate_label(group, value)
    issue = gh.call("GET", f"/issues/{number}")
    keep = [l["name"] for l in issue["labels"] if not l["name"].startswith(group + ":")]
    ensure_label(gh, name)
    gh.call("PUT", f"/issues/{number}/labels", {"labels": keep + [name]})
    return issue


# ----------------------------------------------------------------------- verbs

def set_state(gh, number, state, reason=None):
    """Move the issue to `state`: one state: label, closed for done/dropped
    (reopened for anything else), and the reason comment when given."""
    issue = set_group_label(gh, number, "state", state)
    if state in ("done", "dropped"):
        state_reason = "completed" if state == "done" else "not_planned"
        gh.call("PATCH", f"/issues/{number}", {"state": "closed", "state_reason": state_reason})
    elif issue["state"] == "closed":
        gh.call("PATCH", f"/issues/{number}", {"state": "open"})
    if reason:
        gh.call("POST", f"/issues/{number}/comments", {"body": f"state: {state} — {reason}"})
    return {"number": number, "state": state}


def cmd_state(gh, a):
    return set_state(gh, a.number, a.state, a.reason)


def cmd_complete(gh, a):
    return set_state(gh, a.number, "done")


def read_file(path, what):
    try:
        with open(path, encoding="utf-8-sig") as f:  # -sig: an editor's BOM is not text
            return f.read()
    except (OSError, UnicodeDecodeError) as e:
        raise Failure(f"cannot read {what} file {path}: {getattr(e, 'strerror', None) or e}")


def create_issue(gh, title, body, labels):
    """Open an issue with its labels in the create request, so they are
    present on the `opened` event; creates any label missing in the repo."""
    for name in labels:
        ensure_label(gh, name)
    return gh.call("POST", "/issues", {"title": title, "body": body, "labels": labels})


def cmd_idea(gh, a):
    labels = [validate_label("state", "new"), validate_label("source", a.source)]
    body = read_file(a.body, "body") if a.body else ""
    issue = create_issue(gh, a.title, body, labels)
    return {"number": issue["number"], "url": issue["html_url"]}


def cmd_link(gh, a):
    child = gh.call("GET", f"/issues/{a.child}")
    try:
        gh.call("POST", f"/issues/{a.parent}/sub_issues", {"sub_issue_id": child["id"]})
    except HTTPFailure as e:
        if e.status not in (404, 410):
            raise
        # The sub-issue endpoints are unavailable (a proxy that does not
        # serve them): fall back to the `Parent: #n` body line, but only
        # once the parent is known to exist, so a bad number still fails.
        gh.call("GET", f"/issues/{a.parent}")
        body, line = child.get("body") or "", f"Parent: #{a.parent}"
        existing = re.compile(r"^Parent: #\d+[ \t]*\r?$", re.M)
        if existing.search(body):
            body = existing.sub(line, body, count=1)
        else:
            body = (body.rstrip() + "\n\n" if body.strip() else "") + line + "\n"
        if body != (child.get("body") or ""):
            gh.call("PATCH", f"/issues/{a.child}", {"body": body})
    return {"parent": a.parent, "child": a.child}


# ----------------------------------------------------------- body sections

def prose_lines(lines):
    """(index, line) for every line outside a fenced code block, so a
    `# comment` or a quoted `Depends on:` inside one is never read as
    markup. A fence closes on a fence of the same character."""
    fence = None
    for i, line in enumerate(lines):
        m = re.match(r"[ \t]*(`{3,}|~{3,})", line)
        if m and m.group(1)[0] == "`" and "`" in line[m.end():]:
            m = None  # inline code at line start, not a fence (CommonMark)
        if m and (fence is None or m.group(1)[0] == fence):
            fence = None if fence else m.group(1)[0]
        elif fence is None:
            yield i, line


def find_section(lines, title):
    """(start, end) of the first heading section titled `title`, at any
    heading level, end exclusive; None when absent. The section runs to the
    next heading of the same or a higher level, to a body-convention line,
    or to the end. Fenced code blocks are skipped, so a `# comment` inside
    a quoted command is not a heading."""
    start = level = None
    for i, line in prose_lines(lines):
        h = re.fullmatch(r"(#{1,6})[ \t]+(.*?)[ \t]*#*[ \t]*", line)
        if start is None:
            if h and h.group(2).casefold() == title.casefold():
                start, level = i, len(h.group(1))
        elif (h and len(h.group(1)) <= level) or CONVENTION_LINE.fullmatch(line):
            return start, i
    return None if start is None else (start, len(lines))


def splice(lines, start, end, new):
    """lines[start:end] replaced by `new`, with one blank line on each side
    of it where there is neighbouring content."""
    head, tail = lines[:start], lines[end:]
    while head and not head[-1].strip():
        head.pop()
    while tail and not tail[0].strip():
        tail.pop(0)
    return head + ([""] if head else []) + new + ([""] if tail else []) + tail


def newline_of(body):
    return "\r\n" if "\r\n" in body else "\n"


def with_dod_section(body, text):
    """The body with its definition-of-done section replaced by `text`, or
    `text` appended. `text` is the whole section, heading first; a missing
    or differently levelled heading is normalised to `## Definition of done`.
    Body-convention lines in `text` are dropped: they belong to the body,
    not the section, and `depend` and `link` own them."""
    new = [l for l in text.rstrip().splitlines() if not CONVENTION_LINE.fullmatch(l)]
    while new and not new[0].strip():
        new.pop(0)
    heading = f"## {DOD_TITLE}"
    if new and re.fullmatch(r"#{1,6}[ \t]+" + re.escape(DOD_TITLE) + r"[ \t]*#*[ \t]*", new[0], re.I):
        new[0] = heading
    else:
        new = [heading, ""] + new
    lines = body.splitlines()
    span = find_section(lines, DOD_TITLE)
    if span is None:
        # Append, but ahead of any convention lines that end the body, so
        # `Depends on:` written before scoping still follows the section.
        at = len(lines)
        while at and (not lines[at - 1].strip() or CONVENTION_LINE.fullmatch(lines[at - 1])):
            at -= 1
        span = (at, at)
    return newline_of(body).join(splice(lines, *span, new)) + newline_of(body)


def find_depends_line(lines):
    """Index of the `Depends on:` line, outside any code fence; None if absent."""
    return next((i for i, l in prose_lines(lines) if DEPENDS_LINE.fullmatch(l)), None)


def depends_on(body):
    """The issue numbers on the `Depends on:` line, in order, each once."""
    lines = body.splitlines()
    at = find_depends_line(lines)
    if at is None:
        return []
    return list(dict.fromkeys(int(n) for n in re.findall(r"#(\d+)", lines[at])))


def with_depends_line(body, numbers):
    """The body with its `Depends on:` line rewritten, or created after the
    definition-of-done section (else at the end) when absent."""
    line = "Depends on: " + ", ".join(f"#{n}" for n in numbers)
    lines = body.splitlines()
    at = find_depends_line(lines)
    if at is not None:
        lines[at] = line
    else:
        span = find_section(lines, DOD_TITLE)
        at = span[1] if span else len(lines)
        lines = splice(lines, at, at, [line])
    return newline_of(body).join(lines) + newline_of(body)


# ------------------------------------------------------------ lifecycle verbs

def cmd_scope(gh, a):
    validate_label("route", a.route)
    validate_label("priority", str(a.priority))
    if a.blocked is not None and not a.blocked.strip():
        raise Failure("--blocked needs a reason")
    dod = read_file(a.dod, "--dod")
    if not re.sub(r"\A\s*#{1,6}[ \t]+" + re.escape(DOD_TITLE) + r"[ \t]*#*[ \t]*$", "", dod, flags=re.M | re.I).strip():
        raise Failure(f"--dod file {a.dod} has no text under the heading")
    issue = gh.call("GET", f"/issues/{a.number}")
    body = with_dod_section(issue.get("body") or "", dod)
    if body != (issue.get("body") or ""):
        gh.call("PATCH", f"/issues/{a.number}", {"body": body})
    set_group_label(gh, a.number, "route", a.route)
    set_group_label(gh, a.number, "priority", str(a.priority))
    if a.blocked is not None:
        state = set_state(gh, a.number, "blocked", a.blocked)["state"]
    else:
        state = set_state(gh, a.number, "ready")["state"]
    return {"number": a.number, "route": a.route, "priority": a.priority, "state": state}


def session_ref(explicit):
    if explicit is not None:
        if not explicit.strip():
            raise Failure("--session needs a ref")
        return explicit
    for value in (os.environ.get("CLAUDE_SESSION_ID"), os.environ.get("GITHUB_RUN_ID")):
        if value:
            return value
    try:
        user = getpass.getuser()
    except (OSError, KeyError, ImportError):
        user = "unknown"
    return f"{user}@{socket.gethostname()}"


def cmd_claim(gh, a):
    issue = gh.call("GET", f"/issues/{a.number}")
    states = [l["name"][len("state:"):] for l in issue["labels"] if l["name"].startswith("state:")]
    if states != ["ready"]:
        raise Failure(f"issue #{a.number} is not state:ready (state: {', '.join(states) or 'none'})")
    ref = session_ref(a.session)
    set_state(gh, a.number, "in-progress")
    at = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    try:
        gh.call("POST", f"/issues/{a.number}/comments", {"body": f"claimed by {ref} at {at}"})
    except Failure as e:
        raise Failure(f"{e}; issue #{a.number} is already state:in-progress without a claim comment")
    return {"number": a.number, "claimed_by": ref, "claimed_at": at}


def cmd_depend(gh, a):
    if a.number == a.target:
        raise Failure(f"issue #{a.number} cannot depend on itself")
    issue = gh.call("GET", f"/issues/{a.number}")
    target = gh.call("GET", f"/issues/{a.target}")  # a dependency must exist here
    if "pull_request" in target:
        raise Failure(f"#{a.target} is a pull request, not an issue")
    body = issue.get("body") or ""
    numbers = depends_on(body)
    if a.target not in numbers:
        numbers.append(a.target)
    new = with_depends_line(body, numbers)
    if new != body:
        gh.call("PATCH", f"/issues/{a.number}", {"body": new})
    return {"number": a.number, "depends_on": numbers}


def cmd_request_feature(gh, a):
    if not re.fullmatch(r"[^/\s]+/[^/\s]+", a.to):
        raise Failure(f"--to must be owner/repo, got: {a.to}")
    if not a.kind.strip():
        raise Failure("--kind needs a value")
    hint = "_No response_"
    if a.priority_hint is not None:
        if not 1 <= a.priority_hint <= 5:
            raise Failure(f"invalid --priority-hint: {a.priority_hint} (1 to 5)")
        hint = str(a.priority_hint)
    example, why = read_file(a.example, "--example"), read_file(a.why, "--why")
    cell = gh.repo.split("/", 1)[1]
    remote_gh = GitHub(a.to, gh.token)
    remote_labels = [validate_label("state", "new"), validate_label("source", f"cell:{cell}")]
    # The six headings of request.yml, as the form renders them. The
    # requesting issue is the mirror, which does not exist yet: the field
    # names the cell now and is completed once the mirror is open.
    def remote_body(requester):
        sections = [
            ("Requesting cell and issue", requester),
            ("What is needed", f"Kind: {a.kind.strip()}\n\n{a.title}"),
            ("Example", example.strip()),
            ("Why", why.strip()),
            ("Priority hint", hint),
            (DOD_TITLE, ""),
        ]
        return "".join(f"### {h}\n\n{t}\n\n" for h, t in sections)
    remote = create_issue(remote_gh, a.title, remote_body(gh.repo), remote_labels)
    mirror_body = (
        f"Request to {a.to}: {remote['html_url']}\n\n"
        f"Blocked until {a.to}#{remote['number']} is done.\n\n"
        f"Kind: {a.kind.strip()}\n\n### Example\n\n{example.strip()}\n\n### Why\n\n{why.strip()}\n"
    )
    mirror_labels = [validate_label("state", "blocked"), validate_label("source", "own")]
    # From here a failure leaves issues open: say which, with URLs, so the
    # operator can finish the links by hand rather than file twins.
    mirror = None
    try:
        mirror = create_issue(gh, f"Request to {a.to}: {a.title}", mirror_body, mirror_labels)
        remote_gh.call("PATCH", f"/issues/{remote['number']}",
                       {"body": remote_body(f"{gh.repo}#{mirror['number']}")})
        remote_gh.call("POST", f"/issues/{remote['number']}/comments",
                       {"body": f"Requested by {gh.repo}#{mirror['number']}: {mirror['html_url']}"})
    except Failure as e:
        left = f"remote request already opened at {remote['html_url']}"
        if mirror is None:
            left += ", no mirror here yet"
        else:
            left += f" and mirror at {mirror['html_url']}, remote not yet commented with the mirror"
        raise Failure(f"{e}; {left}")
    return {"remote": {"number": remote["number"], "url": remote["html_url"]},
            "mirror": {"number": mirror["number"], "url": mirror["html_url"]}}


def cmd_merged_count(gh, _a):
    # The search endpoint's total_count, never a listing (cell-operation.md
    # risk table): one call however many PRs have merged.
    url = f"{gh.base}/search/issues?q=repo:{gh.repo}+is:pr+is:merged"
    data = gh.request("GET", url)
    if not isinstance(data, dict) or not isinstance(data.get("total_count"), int):
        raise Failure(f"GET {url}: response has no total_count")
    return {"count": data["total_count"]}


# ------------------------------------------------------------------ thresholds

def parse_yaml_subset(text, path):
    """Nested mappings by two-space indent; scalars as int, float or string.
    No lists, anchors or flow syntax. `#` comments are allowed."""
    root = {}
    stack = [(-1, root)]  # (indent, mapping) for each open mapping
    expect = None         # indent the next line must have after a `key:` opener
    for lineno, raw in enumerate(text.splitlines(), 1):
        line = raw.rstrip()
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        indent = len(line) - len(line.lstrip())
        if "\t" in line[:indent] or indent % 2:
            raise Failure(f"{path}:{lineno}: indent must be a multiple of two spaces")
        m = re.fullmatch(r"([A-Za-z0-9_-]+):(?:\s+(.*))?", line.strip())
        if not m:
            raise Failure(f"{path}:{lineno}: expected `key:` or `key: value`")
        key, value = m.group(1), m.group(2)
        if value is not None and value.startswith("#"):
            value = None
        if expect is not None and indent != expect:
            raise Failure(f"{path}:{lineno}: expected a mapping indented {expect} spaces")
        if expect is None and indent > stack[-1][0] + 2:
            raise Failure(f"{path}:{lineno}: indented too far")
        while stack[-1][0] >= indent:
            stack.pop()
        if key in stack[-1][1]:
            raise Failure(f"{path}:{lineno}: duplicate key {key!r}")
        if value is None:
            child = {}
            stack[-1][1][key] = child
            stack.append((indent, child))
            expect = indent + 2
        else:
            try:
                stack[-1][1][key] = scalar(value)
            except ValueError as e:
                raise Failure(f"{path}:{lineno}: {e}")
            expect = None
    if expect is not None:
        raise Failure(f"{path}: file ends inside an empty mapping")
    return root


def scalar(s):
    """int, float or string; a quoted string keeps `#`, a bare one stops at ` #`."""
    if s[0] in "\"'":
        end = s.find(s[0], 1)
        if end < 0 or not re.fullmatch(r"\s*(#.*)?", s[end + 1:]):
            raise ValueError(f"bad quoted value {s!r}")
        return s[1:end]
    s = s.split(" #", 1)[0].rstrip()
    if re.fullmatch(r"[-+]?\d+", s):
        return int(s)
    if re.fullmatch(r"[-+]?(\d+\.\d*|\.\d+|\d+)([eE][-+]?\d+)?", s):
        return float(s)
    return s


def cmd_threshold(_gh, a):
    path = a.file
    if not path:
        try:
            top = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                                 capture_output=True, text=True, check=True).stdout.strip()
        except (OSError, subprocess.CalledProcessError):
            raise Failure("thresholds.yml: not inside a git repository and no --file given")
        path = os.path.join(top, "thresholds.yml")
    try:
        with open(path, encoding="utf-8") as f:
            data = parse_yaml_subset(f.read(), path)
    except FileNotFoundError:
        raise Failure(f"thresholds file not found: {path}")
    except (OSError, UnicodeDecodeError) as e:
        raise Failure(f"cannot read thresholds file {path}: {getattr(e, 'strerror', None) or e}")
    node = data
    for part in a.key.split("."):
        if not isinstance(node, dict) or part not in node:
            raise Failure(f"threshold key not found: {a.key} in {path}")
        node = node[part]
    if isinstance(node, dict):
        raise Failure(f"threshold key is not a scalar: {a.key} in {path}")
    return node


# ------------------------------------------------------------------------ main

class Parser(argparse.ArgumentParser):
    def error(self, message):
        raise UsageError(message)


def build_parser():
    p = Parser(prog="cellq")
    common = Parser(add_help=False)
    common.add_argument("--repo", metavar="o/r")
    sub = p.add_subparsers(dest="verb", metavar="verb")

    s = sub.add_parser("state", parents=[common])
    s.add_argument("number", type=int)
    s.add_argument("state")
    s.add_argument("--reason")
    s.set_defaults(fn=cmd_state)

    s = sub.add_parser("idea", parents=[common])
    s.add_argument("title")
    s.add_argument("--body", metavar="file")
    s.add_argument("--source", default="own")
    s.set_defaults(fn=cmd_idea)

    s = sub.add_parser("scope", parents=[common])
    s.add_argument("number", type=int)
    s.add_argument("--dod", metavar="file", required=True)
    s.add_argument("--route", required=True)
    s.add_argument("--priority", type=int, required=True)
    s.add_argument("--blocked", metavar="reason")
    s.set_defaults(fn=cmd_scope)

    s = sub.add_parser("claim", parents=[common])
    s.add_argument("number", type=int)
    s.add_argument("--session", metavar="ref")
    s.set_defaults(fn=cmd_claim)

    s = sub.add_parser("complete", parents=[common])
    s.add_argument("number", type=int)
    s.set_defaults(fn=cmd_complete)

    s = sub.add_parser("depend", parents=[common])
    s.add_argument("number", type=int)
    s.add_argument("target", type=int, metavar="m")
    s.set_defaults(fn=cmd_depend)

    s = sub.add_parser("request-feature", parents=[common])
    s.add_argument("title")
    s.add_argument("--to", metavar="o/r", required=True)
    s.add_argument("--kind", required=True)
    s.add_argument("--example", metavar="file", required=True)
    s.add_argument("--why", metavar="file", required=True)
    s.add_argument("--priority-hint", type=int, metavar="p")
    s.set_defaults(fn=cmd_request_feature)

    s = sub.add_parser("merged-count", parents=[common])
    s.set_defaults(fn=cmd_merged_count)

    s = sub.add_parser("link", parents=[common])
    s.add_argument("parent", type=int)
    s.add_argument("child", type=int)
    s.set_defaults(fn=cmd_link)

    s = sub.add_parser("threshold", parents=[common])
    s.add_argument("key")
    s.add_argument("--file", metavar="path")
    s.set_defaults(fn=cmd_threshold, offline=True)

    for verb in sorted(STUBS):
        sub.add_parser(verb, parents=[common])
    return p


def main(argv):
    try:
        verb = argv[1] if len(argv) > 1 else None
        if verb in STUBS:
            raise UsageError(f"{verb}: not implemented")
        if verb is None:
            raise UsageError(f"usage: cellq <verb> [args] [--repo o/r]; verbs: {', '.join(VERBS)}")
        if verb not in VERBS and verb not in ("-h", "--help"):
            raise UsageError(f"unknown verb {verb!r}; verbs: {', '.join(VERBS)}")
        a = build_parser().parse_args(argv[1:])
        gh = None if getattr(a, "offline", False) else GitHub(find_repo(a.repo), find_token())
        print(json.dumps(a.fn(gh, a)))
        return 0
    except UsageError as e:
        print(f"cellq: {e}", file=sys.stderr)
        return 2
    except Failure as e:
        print(f"cellq: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
