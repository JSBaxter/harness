{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__github__(merge_pull_request|enable_pr_auto_merge|create_or_update_file|push_files|delete_file)",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/guard-main-push.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/identity-guard.sh"
          }
        ]
      }
    ]
  }
}
