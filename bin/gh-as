#!/usr/bin/env bash
# gh-as <identity> <gh args...> — run gh pinned to an identity's gh config dir.
# Identities are defined in ~/.claude/identities.local.json (never committed).
set -euo pipefail

MAP="$HOME/.claude/identities.local.json"
id="${1:?usage: gh-as <identity> <gh args...>}"
shift

if [ ! -f "$MAP" ]; then
  echo "gh-as: $MAP not found — copy identities/identities.local.example.json there and fill it in" >&2
  exit 1
fi

dir=$(jq -r ".identities[\"$id\"].ghConfigDir // empty" "$MAP")
if [ -z "$dir" ]; then
  # Empty ghConfigDir means "the default gh login".
  exec gh "$@"
fi

dir="${dir/#\~/$HOME}"
if [ ! -d "$dir" ]; then
  echo "gh-as: no gh config at $dir" >&2
  echo "one-time setup: GH_CONFIG_DIR=$dir gh auth login" >&2
  exit 1
fi

GH_CONFIG_DIR="$dir" exec gh "$@"
